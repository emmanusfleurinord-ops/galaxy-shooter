function completeMission(){
  if(!mission || mission.done || mission.failed) return;
  mission.done=true; mission.progress=mission.need;
  save.medals.missions=(save.medals.missions|0)+1;
  const pts=250+L.n*8;
  addScore(pts, player.x, player.y-50, "MISSÃO");
