const touchCtl={mx:0,my:0,shoot:false,active:false};
function isTouchDevice(){
  return window.matchMedia && (window.matchMedia("(pointer:coarse)").matches || window.matchMedia("(hover:none)").matches) || ("ontouchstart" in window);
}
function syncTouchUI(){
  const on = isTouchDevice() && (state==="play"||state==="boss"||state==="warn");
  document.body.classList.toggle("show-touch", on);
  if(!on){ touchCtl.mx=0; touchCtl.my=0; if(!touchCtl.hold) touchCtl.shoot=false; }
}
function setupTouch(){
  const box=document.getElementById("stickBox");
  const knob=document.getElementById("stickKnob");
  const fire=document.getElementById("btnFire");
  if(!box||!fire) return;
  const setStick=(cx,cy)=>{
    const r=box.getBoundingClientRect();
    const px=cx-(r.left+r.width/2), py=cy-(r.top+r.height/2);
    const max=r.width*0.38;
    const len=Math.sqrt(px*px+py*py)||1;
    const k=Math.min(1,max/len);
    const x=px*k, y=py*k;
    touchCtl.mx=clamp(x/max,-1,1);
    touchCtl.my=clamp(y/max,-1,1);
    knob.style.left=(40+x)+"px";
    knob.style.top=(40+y)+"px";
  };
  const endStick=()=>{ touchCtl.mx=0; touchCtl.my=0; knob.style.left="40px"; knob.style.top="40px"; };
  box.addEventListener("touchstart", e=>{ e.preventDefault(); const t=e.changedTouches[0]; setStick(t.clientX,t.clientY); }, {passive:false});
  box.addEventListener("touchmove", e=>{ e.preventDefault(); const t=e.changedTouches[0]; setStick(t.clientX,t.clientY); }, {passive:false});
  box.addEventListener("touchend", e=>{ e.preventDefault(); endStick(); }, {passive:false});
  box.addEventListener("touchcancel", ()=> endStick());
  const down=e=>{ e.preventDefault(); touchCtl.shoot=true; touchCtl.hold=true; fire.classList.add("on"); };
  const up=e=>{ e.preventDefault(); touchCtl.shoot=false; touchCtl.hold=false; fire.classList.remove("on"); };
  fire.addEventListener("touchstart", down, {passive:false});
  fire.addEventListener("touchend", up, {passive:false});
  fire.addEventListener("touchcancel", up);
  fire.addEventListener("mousedown", down);
  window.addEventListener("mouseup", ()=>{ if(touchCtl.hold){ touchCtl.shoot=false; touchCtl.hold=false; fire.classList.remove("on"); } });
}
function boot(){ ensureShipUnlocked(); syncCfg(); try{ applyScreen(); armFullscreen(); }catch(e){} refreshSaveInfo(); hud(); setupTouch(); showOnly(ovStart); loop(); }
boot();
