  if(!mission || mission.done || mission.failed) return;
  if(mission.id==="safe"){
    if(tookHitLevel){ mission.failed=true; return; }
    mission.frames++;
    mission.progress=Math.min(mission.need, Math.floor(mission.frames/60));
    if(mission.frames>=20*60) completeMission();
  }
}
