<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Galaxy Shooter</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  html, body { height:100%; }
  body { background:#02010a; height:100vh; overflow:hidden; display:flex; flex-direction:column; align-items:center; justify-content:center; font-family:"Segoe UI", system-ui, sans-serif; color:#c8f7ff; }
  body.advanced { background: radial-gradient(ellipse at 50% 20%, #042048 0%, #02010a 55%); }
  h1 { font-size:clamp(14px,3vh,22px); letter-spacing:6px; text-shadow:0 0 10px #0ff,0 0 24px #08f; margin:4px 0; }
  #wrap { position:relative; width:100vw; height:100vh; border:0; box-shadow:none; }
  canvas { display:block; background:#000010; width:100%; height:100%; object-fit:contain; }
  body.normal-screen #wrap { width:min(520px,100vw); height:min(693px,100vh); border:3px solid #0cf; box-shadow:0 0 28px #0ff5; }
  body.normal-screen canvas { width:100%; height:100%; }
  body.advanced canvas { filter: contrast(1.12) saturate(1.2) brightness(1.05); }
  #scan { display:none; pointer-events:none; position:absolute; inset:0; background: repeating-linear-gradient(to bottom, rgba(0,255,255,.03) 0 1px, transparent 2px 4px); }
  body.advanced #scan { display:block; }
  #hud { position:absolute; top:8px; left:10px; right:10px; z-index:2; pointer-events:none; display:flex; justify-content:space-between; gap:8px; font-size:13px; text-shadow:0 0 8px #0ff; }
  #hearts { font-size:18px; letter-spacing:2px; filter: drop-shadow(0 0 6px #f46); }
  .timer { display:none; margin-top:3px; background:#021018cc; border:1px solid #2ac8; border-radius:6px; padding:3px 6px; }
  .timer.on { display:block; }
  .bar { height:4px; background:#133; border-radius:2px; margin-top:3px; overflow:hidden; }
  .bar > i { display:block; height:100%; width:0; background:#0ff; }
  #warn, #toast { position:absolute; left:0; right:0; text-align:center; pointer-events:none; z-index:3; font-weight:800; letter-spacing:2px; display:none; }
  #warn { top:38%; font-size:20px; color:#ff6; text-shadow:0 0 12px #f80; }
  #toast { top:20%; font-size:16px; color:#9ff; text-shadow:0 0 10px #0ff; }
  #scoreEl { font-weight:800; letter-spacing:1px; color:#fff; text-shadow:0 0 8px #6cf, 0 0 18px #09f; }
  #comboEl { margin-top:4px; font-size:15px; font-weight:800; color:#ffd24a; text-shadow:0 0 10px #fa0; letter-spacing:2px; min-height:18px; }
  #bestEl { font-size:11px; color:#9cf; opacity:.9; }
  #hint { margin:6px 0 2px; font-size:12px; color:#7bd; }
  h1, #hint { display:none; }
  body.normal-screen h1, body.normal-screen #hint { display:block; }
  .overlay { position:absolute; inset:0; background:rgba(0,4,16,.82); display:none; align-items:center; justify-content:center; z-index:5; backdrop-filter:blur(3px); }
  .overlay.show { display:flex; }
  .panel { width:min(370px,90%); max-height:92%; overflow:auto; border:1px solid #2cf; background:linear-gradient(180deg,#041428ee,#020814f2); padding:16px; border-radius:10px; box-shadow:0 0 24px #0ff4; }
  .panel h2 { text-align:center; letter-spacing:3px; font-size:18px; color:#7ff; text-shadow:0 0 10px #0ff; margin-bottom:10px; }
  .panel p { text-align:center; color:#bdf; font-size:14px; margin:6px 0; }
  .btn { display:block; width:100%; margin:7px 0; padding:10px; background:#032036; color:#cffffa; border:1px solid #1ad; border-radius:8px; cursor:pointer; font-size:15px; }
  .btn:hover { background:#064060; }
  .btn.main { background:#05334a; border-color:#3ff; }
  .row { display:flex; justify-content:space-between; align-items:center; margin:8px 0; font-size:13px; gap:10px; }
  select, input[type=range] { accent-color:#0cf; }
  select { background:#021018; color:#dff; border:1px solid #1ad; padding:4px 6px; border-radius:6px; }
  .keys { font-size:12px; color:#9de; line-height:1.45; background:#011018; border:1px solid #145; padding:8px; border-radius:6px; }
  #levelGrid { display:grid; grid-template-columns:repeat(6,1fr); gap:4px; max-height:230px; overflow:auto; margin:8px 0; padding:4px; }
  #levelGrid button { padding:6px 0; font-size:11px; background:#021526; color:#cff; border:1px solid #146; border-radius:5px; cursor:pointer; }
  #levelGrid button.on { background:#0a4; border-color:#6f8; color:#fff; }
  #levelGrid button.lock { opacity:.35; cursor:not-allowed; }
  #shipGrid { display:grid; grid-template-columns:repeat(5,1fr); gap:6px; max-height:280px; overflow:auto; margin:8px 0; }
  #shipGrid button { background:#021526; border:2px solid #146; border-radius:8px; padding:4px; cursor:pointer; color:#cff; }
  #shipGrid button.on { border-color:#6ff; background:#043; }
  #shipGrid img { width:100%; height:56px; object-fit:contain; display:block; image-rendering:auto; }
  #shipGrid span { display:block; font-size:10px; text-align:center; margin-top:2px; }
  .cfg-ships { display:grid; grid-template-columns:repeat(4,1fr); gap:5px; max-height:210px; overflow:auto; margin:8px 0; }
  .cfg-ships button { background:#021526; border:2px solid #146; border-radius:7px; padding:3px; cursor:pointer; color:#dff; }
  .cfg-ships button.on { border-color:#6ff; background:#043; }
  .cfg-ships img { width:100%; height:44px; object-fit:contain; display:block; }
  .cfg-ships span { display:block; font-size:9px; text-align:center; }

  #touchUI { display:none; position:absolute; inset:0; z-index:6; pointer-events:none; }
  body.show-touch #touchUI { display:block; }
  #stickBox { pointer-events:auto; position:absolute; left:12px; bottom:18px; width:120px; height:120px; border-radius:50%; background:rgba(0,30,50,.35); border:2px solid rgba(80,220,255,.35); }
  #stickKnob { position:absolute; left:40px; top:40px; width:40px; height:40px; border-radius:50%; background:rgba(120,230,255,.55); border:2px solid #9ff; }
  #btnFire { pointer-events:auto; position:absolute; right:16px; bottom:28px; width:86px; height:86px; border-radius:50%; border:3px solid #6ff; background:rgba(0,180,220,.32); color:#eaffff; font-weight:800; letter-spacing:1px; font-size:13px; }
  #btnFire.on { background:rgba(0,255,180,.45); }
  #touchHint { position:absolute; left:0; right:0; bottom:4px; text-align:center; font-size:10px; color:#8df; opacity:.8; pointer-events:none; }

  #ovSector h2 { font-size:22px; letter-spacing:3px; color:#9ff; }
  #ovSector .sec-num { color:#6cf; letter-spacing:4px; font-size:12px; margin-bottom:6px; }

  #missionEl { font-size:11px; letter-spacing:1px; color:#9ef; margin-top:4px; max-width:220px; }
  #missionEl.ok { color:#8f8; }
  #missionEl.fail { color:#f88; }
  #clearMedals, #clearMission { font-size:12px; color:#bff; margin:6px 0; }
  #medalList { text-align:left; font-size:12px; line-height:1.5; margin:8px 0; }

  #rankList { max-height:280px; overflow:auto; text-align:left; font-size:12px; line-height:1.45; }
  #rankList div { display:flex; justify-content:space-between; gap:8px; border-bottom:1px solid #134; padding:3px 0; }
  #rankList .new { color:#8f8; }
  #clearRecord { font-size:12px; color:#9ef; margin:6px 0; }

  #shipLockMsg { display:none; background:#3a1020; border:2px solid #f86; color:#fdd; padding:10px 12px; border-radius:8px; font-size:13px; line-height:1.35; margin:8px 0; }
  #shipLockMsg.show { display:block; }

  #shipSpinWrap { display:flex; justify-content:center; margin:6px 0 2px; }
  #shipSpin { width:120px; height:120px; }
  #ovUnlock img { width:140px; height:90px; object-fit:contain; filter:drop-shadow(0 0 12px #6ff); }

  #warn { text-align:center; }
  #warn img { height:72px; margin:6px 0; filter:drop-shadow(0 0 10px #f86); }
  #warn .card { font-size:13px; letter-spacing:1px; }
  #ovSectorDone h2 { letter-spacing:3px; }
</style>
</head>
<body>
<h1>✦ GALAXY SHOOTER ✦</h1>
<div id="wrap">
  <canvas id="c" width="480" height="640"></canvas>
  <div id="scan"></div>
  <div id="hud">
    <div>
      <div id="hearts">❤️❤️❤️</div>
      <div id="hpEl">TIROS: 0 / 5</div>
      <div id="scoreEl">PONTOS 0</div>
      <div id="bestEl">RECORDE 0</div>
      <div id="comboEl"></div>
      <div id="missionEl"></div>
      <div id="waveEl">NÍVEL 1 / 300</div>
      <div id="subEl">TEMPO 2:00</div>
    </div>
    <div>
      <div class="timer" id="tDouble"><b>TIRO DUPLO</b> <span>0s</span><div class="bar"><i></i></div></div>
      <div class="timer" id="tTriple"><b>TIRO TRIPLO</b> <span>0s</span><div class="bar"><i></i></div></div>
      <div class="timer" id="tShield"><b>ESCUDO</b> <span>0s</span><div class="bar"><i></i></div></div>
      <div class="timer" id="tLaser"><b>LASER</b> <span>0s</span><div class="bar"><i></i></div></div>
      <div class="timer" id="tMissile"><b>MÍSSEIS</b> <span>0s</span><div class="bar"><i></i></div></div>
      <div class="timer" id="tSpread"><b>LEQUE</b> <span>0s</span><div class="bar"><i></i></div></div>
    </div>
  </div>
  <div id="warn">⚠ CHEFÃO CHEGANDO ⚠</div>
  <div id="toast"></div>

  <div id="touchUI">
    <div id="stickBox"><div id="stickKnob"></div></div>
    <button id="btnFire" type="button">ATIRAR</button>
    <div id="touchHint">Celular: use os botões na tela. Controle USB/Bluetooth só se o navegador aceitar.</div>
  </div>


  <div class="overlay show" id="ovStart">
    <div class="panel">
      <h2>GALAXY SHOOTER</h2>
      <button class="btn main" id="btnLevels">▶  ESCOLHER NÍVEL</button>
      <button class="btn" id="btnShips">🚀  ESCOLHER NAVE</button>
      <button class="btn" id="btnCfgStart">⚙  CONFIGURAÇÕES</button>
      <button class="btn" id="btnMedals">🏅  MEDALHAS</button>
      <button class="btn" id="btnRank">📊  RECORDES</button>
      <button class="btn" id="btnFull">TELA TODA</button>
      <div class="keys" id="saveInfo">Teclado, toque no celular ou controle. Chefão único a cada vez.</div>
    </div>
  </div>
  <div class="overlay" id="ovShips">
    <div class="panel">
      <h2>ESCOLHER NAVE</h2>
      <p id="shipPicked">Toque na foto da nave</p>
      <div id="shipSpinWrap"><canvas id="shipSpin" width="120" height="120"></canvas></div>
      <p id="shipLockMsg"></p>
      <div id="shipGrid"></div>
      <button class="btn main" id="btnShipOk">✔  USAR ESTA NAVE</button>
      <button class="btn" id="btnShipBack">↩  VOLTAR</button>
    </div>
  </div>
  <div class="overlay" id="ovLevels">
    <div class="panel">
      <h2>ESCOLHER NÍVEL</h2>
      <p id="unlockInfo">Liberados até o nível 1</p>
      <div id="levelGrid"></div>
      <button class="btn main" id="btnPlayPick">▶  JOGAR NÍVEL 1</button>
      <button class="btn" id="btnLvBack">↩  VOLTAR</button>
    </div>
  </div>
  <div class="overlay" id="ovPause">
    <div class="panel">
      <h2>PAUSA</h2>
      <button class="btn main" id="btnResume">▶  CONTINUAR</button>
      <button class="btn" id="btnCfgPause">⚙  CONFIGURAÇÕES</button>
      <button class="btn" id="btnMenu">↩  TELA INICIAL</button>
    </div>
  </div>
  <div class="overlay" id="ovClear">
    <div class="panel">
      <h2>NÍVEL COMPLETO</h2>
      <p id="clearLevel">Nível 1 de 300</p>
      <p id="clearBoss">Chefão derrotado</p>
      <p id="clearScore">Pontos: 0</p>
      <p id="clearMission"></p>
      <p id="clearMedals"></p>
      <p id="clearRecord"></p>
      <button class="btn main" id="btnPickAfter">▶  ESCOLHER PRÓXIMO NÍVEL</button>
      <button class="btn" id="btnClearMenu">↩  TELA INICIAL</button>
    </div>
  </div>
  
  <div class="overlay" id="ovSector">
    <div class="panel">
      <p class="sec-num" id="sectorNum">SETOR 1 / 30</p>
      <h2 id="sectorTitle">Nebulosa Inicial</h2>
      <p id="sectorRange">Níveis 1 a 10</p>
      <p id="sectorBlurb">Uma nuvem de estrelas novas. Os primeiros chefões vigiam a entrada.</p>
      <button class="btn main" id="btnEnterSector">▶  ENTRAR NO SETOR</button>
    </div>
  </div>

  
  
  
  
  <div class="overlay" id="ovSectorDone">
    <div class="panel">
      <p class="sec-num" id="doneSecNum">SETOR 1</p>
      <h2>SETOR CONCLUÍDO</h2>
      <p id="doneSecName">Nebulosa Inicial</p>
      <p id="doneSecTxt">Você atravessou os 10 níveis deste setor.</p>
      <button class="btn main" id="btnSectorDone">▶  CONTINUAR</button>
    </div>
  </div>

  <div class="overlay" id="ovUnlock">
    <div class="panel">
      <h2>NOVA NAVE DESBLOQUEADA</h2>
      <img id="unlockImg" alt="nave">
      <p id="unlockName">Nave</p>
      <p id="unlockNote"></p>
      <button class="btn main" id="btnUnlockOk">✔  CONTINUAR</button>
    </div>
  </div>

  <div class="overlay" id="ovRank">
    <div class="panel">
      <h2>RECORDES</h2>
      <p>Melhor pontuação e melhor tempo de cada nível, salvos neste computador.</p>
      <div id="rankList"></div>
      <button class="btn main" id="btnRankBack">↩  VOLTAR</button>
    </div>
  </div>

  <div class="overlay" id="ovMedals">
    <div class="panel">
      <h2>MEDALHAS</h2>
      <div id="medalList">Ainda nenhuma medalha.</div>
      <button class="btn main" id="btnMedalsBack">↩  VOLTAR</button>
    </div>
  </div>

  <div class="overlay" id="ovCfg">
    <div class="panel">
      <h2>CONFIGURAÇÕES</h2>
      <div class="row"><label>Voz</label>
        <select id="optVoice"><option value="on">Ligada</option><option value="off">Desligada</option></select></div>
      <div class="row"><label>Som</label>
        <select id="optSound"><option value="on">Ligado</option><option value="off">Desligado</option></select></div>
      <div class="row"><label>Música</label>
        <select id="optMusic"><option value="on">Ligada</option><option value="off">Desligada</option></select></div>
      <div class="row"><label>Volume</label><input id="optVol" type="range" min="0" max="100" value="70"></div>
      <div class="row"><label>Pacote de som</label>
        <select id="optPack">
          <option value="0">1. Clássico</option>
          <option value="1">2. Laser Neon</option>
          <option value="2">3. Estrela</option>
          <option value="3">4. Robô</option>
          <option value="4">5. Cristal</option>
          <option value="5">6. Trovão</option>
          <option value="6">7. 8-bits</option>
          <option value="7">8. Espacial</option>
          <option value="8">9. Doce</option>
          <option value="9">10. Heroico</option>
        </select></div>
      <button class="btn" id="btnPreview" type="button">♪  Ouvir o som escolhido</button>
      <div class="row"><label>Tela</label>
        <select id="optScreen">
          <option value="normal">Normal</option>
          <option value="full">Cheia</option>
          <option value="advanced">Cheia avançada</option>
        </select></div>
      <div class="row"><label>Dificuldade</label>
        <select id="optDiff">
          <option value="easy">Fácil</option>
          <option value="normal">Normal</option>
          <option value="hard">Difícil</option>
        </select></div>
      <div class="row"><label>Velocidade dos inimigos</label>
        <select id="optESpd">
          <option value="very">Bem lenta</option>
          <option value="slow">Lenta</option>
          <option value="normal">Normal</option>
          <option value="fast">Rápida</option>
        </select></div>
      <div class="row"><label>Fundo da tela</label>
        <select id="optBg">
          <option value="atual">Atual (brilhante)</option>
          <option value="noite">Noite escura</option>
          <option value="azul">Azul suave</option>
          <option value="roxo">Roxo profundo</option>
          <option value="verde">Verde calmo</option>
          <option value="ouro">Dourado fraco</option>
          <option value="estrelas">Só estrelas</option>
          <option value="aurora">Aurora</option>
          <option value="vermelho">Vermelho suave</option>
          <option value="oceano">Oceano</option>
          <option value="cinza">Cinza espacial</option>
        </select></div>
      <div class="row"><label>Velocidade da nave</label>
        <select id="optSpeed">
          <option value="slow">Lenta</option>
          <option value="normal">Normal</option>
          <option value="fast">Rápida</option>
        </select></div>
      <div class="row"><label>Controle / manette</label>
        <select id="optPad"><option value="on">Ligado</option><option value="off">Desligado</option></select></div>
      <div class="row"><label>Tiro automático</label>
        <select id="optAuto"><option value="off">Não</option><option value="on">Sim</option></select></div>
      <div class="row"><label>Amigos de suporte</label>
        <select id="optAlly"><option value="on">Sim</option><option value="off">Não</option></select></div>
      <div class="row"><label>Efeitos visuais</label>
        <select id="optFx">
          <option value="low">Mínimo</option>
          <option value="normal">Normal</option>
          <option value="high">Máximo</option>
        </select></div>
      <div class="row"><label>Tremor de tela</label>
        <select id="optShake"><option value="on">Sim</option><option value="off">Não</option></select></div>
      <div class="row"><label>Mostrar cronômetro</label>
        <select id="optClock"><option value="on">Sim</option><option value="off">Não</option></select></div>
      <div class="keys">W A S D ou setas • ESPAÇO atira • ESC pausa<br>Corações caem no jogo para recuperar vida</div>
      <h2 style="font-size:15px;margin-top:12px;">NAVES — COMPARAR E ESCOLHER</h2>
      <div id="cfgShipGrid" class="cfg-ships"></div>
      <div id="shipCompare" style="margin:10px 0;max-height:200px;overflow:auto;font-size:11px;line-height:1.4;background:#011018;border:1px solid #145;border-radius:6px;padding:6px;"></div>
      <p id="saveCfgMsg" style="text-align:center;color:#8f8;font-size:13px;margin:8px 0;">As opções são guardadas neste navegador.</p>
      <button class="btn main" id="btnSaveCfg">💾  SALVAR / ENREGISTRER</button>
      <button class="btn" id="btnCfgBack">↩  VOLTAR</button>
    </div>
  </div>
</div>
<p id="hint">Escolha o nível • Teclado ou controle (manette) • ESPAÇO / botão A atira • ESC / Start pausa</p>
