function fillShipCompare(){
  const box=document.getElementById("shipCompare");
  const grid=document.getElementById("cfgShipGrid");
  if(grid){
    grid.innerHTML="";
    SHIPS.forEach((sh,i)=>{
      const b=document.createElement("button");
      if(i===(cfg.ship|0)) b.className="on";
      const im=document.createElement("img"); im.src=SRC[sh.key]||""; im.alt=sh.name;
      const sp=document.createElement("span"); sp.textContent=(i+1)+". "+sh.name+(i===SHIPS.length-1?" ★":"");
      b.appendChild(im); b.appendChild(sp);
      if(!shipUnlocked(i)){ b.classList.add("lock"); b.onclick=()=>{}; return void grid.appendChild(b); }
      b.onclick=()=>{ cfg.ship=i; persist(); player.speed=shipSpeed(); fillShipCompare(); };
      grid.appendChild(b);
    });
  }
  if(!box) return;
  let html="<b>Comparação da 1ª até a última nave</b><br>";
  SHIPS.forEach((sh,i)=>{
    const mark = i===(cfg.ship|0) ? " ◀ escolhida" : "";
    const star = i===SHIPS.length-1 ? " ★ MAIS PERIGOSA" : "";
    html += (i+1)+". "+sh.name+" — dano x"+sh.dmg.toFixed(2)+" • tiro "+Math.round(100/sh.cd)+"% • vel "+Math.round(sh.spd*100)+"% — "+sh.note+star+mark+"<br>";
  });
  box.innerHTML=html;
}
