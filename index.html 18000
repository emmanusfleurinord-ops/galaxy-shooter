function drawUniqueBoss(){
  const B=L.boss, x=boss.x, y=boss.y, w=boss.w, h=boss.h;
  const keys=bossSpriteKeys();
  const key=B.sprite || keys[(B.id||0)%keys.length];
  const img=IMG[key] || IMG.boss || IMG.enemy;
  ctx.save();
  const hue=((B.hue%360)+360)%360;
  ctx.filter="hue-rotate("+hue+"deg) saturate(1.06) contrast(1.08)";
  ctx.shadowColor="rgba(0,0,0,0.55)"; ctx.shadowBlur=14;
  if(B.flip){
    ctx.translate(x+w, y);
    ctx.scale(-1,1);
    if(img && img.complete && img.naturalWidth) ctx.drawImage(img, 0, 0, w, h);
    else { ctx.fillStyle="#889"; ctx.fillRect(0,0,w,h); }
  } else if(img && img.complete && img.naturalWidth) ctx.drawImage(img, x, y, w, h);
  else { ctx.fillStyle="#889"; ctx.fillRect(x,y,w,h); }
  ctx.filter="none"; ctx.shadowBlur=0;
  ctx.restore();
}
function sectorPalette(n){
  const pal=[
    ["#071830","#12325a","#6cf"],["#1a1408","#3a2810","#fc6"],["#101828","#2a3a58","#adf"],
    ["#180818","#3a1040","#f7f"],["#200808","#4a1414","#f66"],["#081418","#123038","#8ff"],
    ["#081018","#142848","#9bf"],["#04060c","#10141c","#89a"],["#201408","#4a3010","#fd6"],
    ["#061018","#0c2840","#6af"]
  ];
  return pal[(sectorOf(n||1)-1)%pal.length];
}
function drawBackdrop(){
  const id=cfg.bg||"atual";
  const oy=(tick*0.12)%H;
  const pal=sectorPalette(L&&L.n?L.n:1);
  if(id==="atual" && IMG.bg && IMG.bg.complete && IMG.bg.naturalWidth){
    ctx.save();
    ctx.filter="hue-rotate("+(((L&&L.n?L.n:1)*37)%360)+"deg) saturate(1.15)";
    ctx.globalAlpha=0.88;
    ctx.drawImage(IMG.bg,0,-oy,W,H);
    ctx.drawImage(IMG.bg,0,H-oy,W,H);
    ctx.restore();
    ctx.fillStyle=pal[0];
    ctx.globalAlpha=0.28;
    ctx.fillRect(0,0,W,H);
    ctx.globalAlpha=1;
  } else {
  const themes={
    noite:["#02010a","#070616","#000"],
    azul:["#03101c","#0a2238","#061018"],
    roxo:["#100818","#1a0a2a","#080410"],
    verde:["#03140c","#0a2418","#02100a"],
    ouro:["#120e06","#1c160a","#0a0804"],
    estrelas:["#010105","#020208","#000"],
    aurora:["#041016","#06281c","#081022"],
    vermelho:["#140808","#220c0c","#0a0404"],
    oceano:["#020b16","#062030","#041018"],
    cinza:["#0a0a10","#12121a","#07070c"]
  };
  const c=themes[id]||themes.noite;
  const g=ctx.createLinearGradient(0,0,0,H);
  g.addColorStop(0,c[0]); g.addColorStop(0.55,c[1]); g.addColorStop(1,c[2]);
  ctx.fillStyle=g; ctx.fillRect(0,0,W,H);
  if(id==="aurora"){
    ctx.globalAlpha=0.18;
    ctx.fillStyle="#40ffaa"; ctx.beginPath(); ctx.ellipse(W*0.3,80,180,40,0.2,0,Math.PI*2); ctx.fill();
    ctx.fillStyle="#40a0ff"; ctx.beginPath(); ctx.ellipse(W*0.7,120,160,36,-0.2,0,Math.PI*2); ctx.fill();
    ctx.globalAlpha=1;
  }
  }
  planets.forEach(p=>{
    ctx.save();
    ctx.globalAlpha=0.55;
    const g=ctx.createRadialGradient(p.x-p.r*0.3,p.y-p.r*0.3,2,p.x,p.y,p.r);
    g.addColorStop(0,"hsla("+p.hue+",70%,70%,0.9)");
    g.addColorStop(1,"hsla("+p.hue+",50%,18%,0.15)");
    ctx.fillStyle=g;
    ctx.beginPath(); ctx.arc(p.x,p.y,p.r,0,Math.PI*2); ctx.fill();
    if(p.ring){
      ctx.strokeStyle="hsla("+((p.hue+40)%360)+",80%,70%,0.35)";
      ctx.lineWidth=2;
      ctx.beginPath(); ctx.ellipse(p.x,p.y,p.r*1.6,p.r*0.45,0.4,0,Math.PI*2); ctx.stroke();
    }
    ctx.restore();
  });
}
