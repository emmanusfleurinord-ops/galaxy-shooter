function drawWeaponIcon(d){
  const x=d.x, y=d.y, w=d.w, h=d.h, cx=x+w/2, cy=y+h/2;
  const col=d.type==="laser"?"#4ef":d.type==="missile"?"#f74":d.type==="spread"?"#fd4":"#f55";
  ctx.save();
  ctx.fillStyle=col; ctx.strokeStyle="#fff"; ctx.lineWidth=2;
  ctx.beginPath();
  if(ctx.roundRect) ctx.roundRect(x,y,w,h,6); else ctx.rect(x,y,w,h);
  ctx.fill(); ctx.stroke();
  ctx.fillStyle="#012"; ctx.strokeStyle="#012"; ctx.lineWidth=2;
  if(d.type==="laser"){
    ctx.beginPath(); ctx.moveTo(cx,y+4); ctx.lineTo(cx-6,cy+2); ctx.lineTo(cx-2,cy+2); ctx.lineTo(cx-5,y+h-4); ctx.lineTo(cx+7,cy-1); ctx.lineTo(cx+2,cy-1); ctx.closePath(); ctx.fill();
  } else if(d.type==="missile"){
    ctx.beginPath(); ctx.moveTo(cx,y+4); ctx.lineTo(cx+6,cy+2); ctx.lineTo(cx+3,y+h-5); ctx.lineTo(cx-3,y+h-5); ctx.lineTo(cx-6,cy+2); ctx.closePath(); ctx.fill();
    ctx.fillStyle="#a20"; ctx.fillRect(cx-3,y+h-8,6,5);
  } else if(d.type==="spread"){
    ctx.beginPath();
    ctx.moveTo(cx,y+h-5); ctx.lineTo(cx-10,y+6); ctx.moveTo(cx,y+h-5); ctx.lineTo(cx,y+5); ctx.moveTo(cx,y+h-5); ctx.lineTo(cx+10,y+6);
    ctx.stroke();
  } else {
    ctx.beginPath(); ctx.arc(cx,cy+2,7,0,Math.PI*2); ctx.fill();
    ctx.fillStyle=col; ctx.fillRect(cx-2,y+4,4,7);
  }
  ctx.restore();
}
