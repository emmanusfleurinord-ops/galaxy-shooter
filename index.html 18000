let musicCtl={timer:null, sector:-1, nodes:[]};
function stopMusic(){
  if(musicCtl.timer){ clearInterval(musicCtl.timer); musicCtl.timer=null; }
  musicCtl.nodes.forEach(n=>{ try{ n.stop(); }catch(e){} });
  musicCtl.nodes=[];
  musicCtl.sector=-1;
}
function startSectorMusic(n){
  try{
    unlockAudio();
    if(cfg.sound===false || cfg.music===false || !actx){ stopMusic(); return; }
    const sec=sectorOf(n||1);
    if(musicCtl.sector===sec && musicCtl.timer) return;
    stopMusic();
    musicCtl.sector=sec;
    const roots=[174,196,220,233,247,262,277,294,311,330];
    const root=roots[(sec-1)%roots.length];
    const modes=[[0,3,7,10],[0,4,7,11],[0,3,7,12],[0,5,7,10],[0,2,7,9],[0,4,7,9]];
    const mode=modes[(sec-1)%modes.length];
    const types=["triangle","sine","square","sawtooth"];
    const type=types[(sec-1)%types.length];
    const gap=280+(sec%6)*18;
    let step=0;
    function tone(freq,dur,typ,vol){
      if(!actx) return;
      const o=actx.createOscillator(), g=actx.createGain();
      o.type=typ; o.frequency.value=freq;
      const now=actx.currentTime;
      g.gain.setValueAtTime(0.0001, now);
      g.gain.exponentialRampToValueAtTime((cfg.volume||0.7)*vol*0.07, now+0.03);
      g.gain.exponentialRampToValueAtTime(0.0001, now+dur);
      o.connect(g); g.connect(actx.destination);
      o.start(now); o.stop(now+dur+0.02);
      musicCtl.nodes.push(o);
      if(musicCtl.nodes.length>24) musicCtl.nodes.splice(0,8);
    }
    musicCtl.timer=setInterval(()=>{
      if(cfg.sound===false || cfg.music===false){ stopMusic(); return; }
      if(!(state==="play"||state==="boss"||state==="warn"||state==="bossboom")) return;
      const note=mode[step%mode.length];
      tone(root*Math.pow(2, note/12), 0.26, type, 1);
      if(step%4===0) tone(root/2, 0.5, "sine", 0.8);
      if(step%8===4) tone(root*Math.pow(2, mode[(step+2)%mode.length]/12)*2, 0.18, "triangle", 0.45);
      step++;
    }, gap);
  }catch(e){}
}
let actx=null;
function unlockAudio(){ try{ if(!actx) actx=new (window.AudioContext||window.webkitAudioContext)(); if(actx.state==="suspended") actx.resume(); }catch(e){} }
let lastVoice="";
function speak(text, force){
  try{
    if(cfg.sound===false || cfg.voice===false) return;
    if(!window.speechSynthesis) return;
    const t=(""+text).trim();
    if(!t) return;
    if(!force && t===lastVoice) return;
    lastVoice=t;
    speechSynthesis.cancel();
    const u=new SpeechSynthesisUtterance(t);
    u.lang="pt-BR";
    u.rate=1.02;
    u.pitch=1;
    u.volume=Math.max(0.3, Math.min(1, cfg.volume||0.8));
    const vs=speechSynthesis.getVoices()||[];
    const br=vs.find(v=>/pt-BR/i.test(v.lang)) || vs.find(v=>/^pt/i.test(v.lang));
    if(br) u.voice=br;
    speechSynthesis.speak(u);
  }catch(e){}
}
