function shot(x,y,vx,vy,opt){
  eBullets.push({x:x-3,y:y,w:(opt&&opt.w)||6,h:(opt&&opt.h)||12,vx,vy,enemyShot:true});
}
function aimVec(x,y,spd){
  const dx=player.x-x, dy=player.y-y, l=Math.hypot(dx,dy)||1;
  return {vx:dx/l*spd, vy:dy/l*spd};
}
function fan(x,y,spd,n,spread,base){
  const mid=(n-1)/2;
  for(let i=0;i<n;i++){
    const a=(base||Math.PI/2)+((i-mid)*spread);
    shot(x,y,Math.cos(a)*spd,Math.sin(a)*spd);
  }
}
function ring(x,y,spd,n,rot){
  for(let i=0;i<n;i++){
    const a=rot+i*Math.PI*2/n;
    shot(x,y,Math.cos(a)*spd,Math.sin(a)*spd);
  }
}
function bossShoot(){
  sfx.bShot();
  const cx=boss.x+boss.w/2, cy=boss.y+boss.h-4;
  const spd=(2.4+L.n*0.01)*diffMul();
  const atk=L.boss.atk;
  boss.spin=(boss.spin||0)+0.28;
  if(atk===0){ shot(cx,cy,0,spd+0.6,{w:8,h:16}); }
  else if(atk===1){ fan(cx,cy,spd,5,0.18,Math.PI/2); }
  else if(atk===2){ const v=aimVec(cx,cy,spd*1.25); shot(cx,cy,v.vx,v.vy,{w:8,h:14}); }
  else if(atk===3){ fan(cx,cy,spd,3,0.22,Math.PI/2); const v=aimVec(cx,cy,spd); shot(cx,cy,v.vx,v.vy); }
  else if(atk===4){ ring(cx,cy,spd*0.95,12,boss.spin); }
  else if(atk===5){ shot(cx-28,cy,0,spd); shot(cx+28,cy,0,spd); shot(cx,cy,0,spd+0.8); }
  else if(atk===6){ for(let i=0;i<4;i++) shot(cx+(i-1.5)*8,cy,0,spd+0.4+i*0.15); }
  else if(atk===7){
    const wob=Math.sin(tick/10)*0.55;
    fan(cx,cy,spd,5,0.16,Math.PI/2+wob);
  }
  else if(atk===8){
    shot(cx,cy,0,spd); shot(cx,cy,spd,0); shot(cx,cy,-spd,0); shot(cx,cy,0,-spd*0.4);
    const v=aimVec(cx,cy,spd); shot(cx,cy,v.vx,v.vy);
  }
  else if(atk===9){
    const a=boss.spin;
    shot(cx,cy,Math.cos(a)*spd,Math.sin(a)*spd);
    shot(cx,cy,Math.cos(a+Math.PI)*spd,Math.sin(a+Math.PI)*spd);
  }
  else if(atk===10){
    for(let i=-2;i<=2;i++) shot(cx+i*22, cy, i*0.15, spd);
  }
  else {
    const a=boss.spin, b=boss.spin+Math.PI/2;
    shot(cx,cy,Math.cos(a)*spd,Math.sin(a)*spd);
    shot(cx,cy,Math.cos(-a)*spd,Math.sin(-a)*spd);
    shot(cx,cy,Math.cos(b)*spd,Math.sin(b)*spd);
    shot(cx,cy,Math.cos(-b)*spd,Math.sin(-b)*spd);
  }
}
function updateBoss(){
  if(!boss) return;
  if(!boss.entered){ if(boss.lock>0){ boss.lock--; if(boss.lock<=0) boss.entered=true; } return; }
  const m=L.boss.move, ch=L.bossChase*diffMul()*0.55, tx=player.x-boss.w/2;
  if(Math.abs(boss.vx)<0.6) boss.vx=(boss.vx>=0?1:-1)*L.bossSpeed*0.55;
  if(m===0){ boss.x+=boss.vx; if(boss.x<10||boss.x+boss.w>W-10) boss.vx*=-1; }
  else if(m===1){ boss.x+=Math.sign(tx-boss.x)*ch*0.7; }
  else if(m===2){ boss.x+=Math.sign(tx-boss.x)*ch*0.65; boss.y+= (40-boss.y)*0.02; }
  else if(m===3){ boss.x+=Math.sign(tx-boss.x)*ch*0.8; boss.y+=(36-boss.y)*0.02; }
  else if(m===4){ boss.x=W/2-boss.w/2+Math.sin(tick*0.018)*90; }
  else if(m===5){ boss.x+=boss.vx; if(boss.x<10||boss.x+boss.w>W-10) boss.vx*=-1; }
  else if(m===6){ if(boss.dash<=0){ boss.dash=140; boss.vx=Math.sign(tx-boss.x)*ch*1.2; } boss.dash--; boss.x+=boss.vx*0.7; }
  else if(m===7){ boss.x=clamp(boss.x+Math.sign(tx-boss.x)*L.bossSpeed*0.35,10,W-boss.w-10); }
  else if(m===8){ boss.x=W/2-boss.w/2+Math.sin(tick*0.02)*110; }
  else if(m===9){ boss.x+=Math.sign(tx-boss.x)*ch*0.75; }
  else if(m===10){ boss.x=W/2-boss.w/2+Math.sin(tick*0.016)*120; }
  else { if(tick%110===0) boss.x=clamp(player.x-boss.w/2,12,W-boss.w-12); }
  boss.y=clamp(boss.y, 28, 90);
  boss.x=clamp(boss.x,8,W-boss.w-8);
  boss.shoot++;
  if(boss.shoot>Math.max(12, L.bossFire/diffMul())){ boss.shoot=0; bossShoot(); }
  if(tick%360===0){
    dropAt(80+Math.random()*(W-160), 40, true);
  }
  bossFriends.forEach(f=>{
    const tx2=boss.x+boss.w/2+f.side*70, ty2=boss.y+58;
    f.x+=(tx2-f.x)*0.08; f.y+=(ty2-f.y)*0.08;
    if(f.cd>0) f.cd--;
    else {
      f.cd=Math.max(28, 56-L.n*0.06);
      const dx=player.x-f.x, dy=player.y-f.y, len=Math.hypot(dx,dy)||1, spd=2.3*diffMul();
      eBullets.push({x:f.x-3,y:f.y+10,w:6,h:14,vx:dx/len*spd,vy:dy/len*spd,enemyShot:true});
      sfx.minionShot();
    }
  });
}
function update(){
