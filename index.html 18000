function saveLevelRecord(n, sc, frames){
  if(!save.records) save.records={};
  const prev=save.records[n]||{};
  const out={score:prev.score||0, time:prev.time||0};
  let news=[];
  if(!prev.score || sc>prev.score){ out.score=sc; news.push("pontos"); }
  if(!prev.time || frames<prev.time){ out.time=frames; news.push("tempo"); }
  save.records[n]=out;
  persist();
  return news;
}
