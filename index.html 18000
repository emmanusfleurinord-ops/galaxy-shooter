const N1=["Vórtex","Nébula","Kraag","Zorath","Nyx","Helion","Drak","Quasar","Orion","Vex","Sable","Pyra","Ion","Ruk","Astra","Morb","Kel","Zeph","Onyx","Luma"];
const N2=["Carmesim","Gélido","Solar","Umbra","Titã","Feral","Ómega","Prismático","Oco","Radiante","Bruto","Etéreo","Colosso","Sombrio","Vivo","Quebrado","Ancestral","Novo","Final","Errante"];
const N3=["da Chama","do Vazio","de Ferro","de Cristal","da Tempestade","do Eclipse","da Maré","do Ápice","de Plasma","da Ruína","das Asas","do Núcleo","da Orbe","dos Canhões","da Serpe","do Cometa","da Torre","do Abismo","da Aurora","do Pacto"];
const MOVE_NAME=["Varredura","Perseguição","Mergulho","Caçada","Órbita","Ricochete","Investida","Régua","Triângulo","Assalto","Pêndulo","Salto"];
const ATK_NAME=["Feixe","Leque","Mira","Combo","Anel","Canhões","Rajada","Onda","Cruz","Espiral","Chuva","Duplo giro"];
function clamp(v,a,b){ return Math.max(a,Math.min(b,v)); }
function rects(a,b){ return a.x<b.x+b.w && a.x+a.w>b.x && a.y<b.y+b.h && a.y+a.h>b.y; }
function fat(e,px,py){ return {x:e.x-px,y:e.y-py,w:e.w+px*2,h:e.h+py*2}; }
function hitSweep(b,e){
  const steps=5;
  const ox=b.px!=null?b.px:b.x-(b.vx||0);
  const oy=b.py!=null?b.py:b.y-(b.vy||0);
  const er=fat(e,8,6);
  for(let i=0;i<=steps;i++){
    const t=i/steps;
    const box={x:ox+(b.x-ox)*t-3, y:oy+(b.y-oy)*t-3, w:(b.w||6)+6, h:(b.h||16)+6};
    if(rects(box,er)) return true;
  }
  return false;
}
function uniqueTriple(id,a,b,c){
  const n=a*b*c; id=((id%n)+n)%n;
  return [Math.floor(id/(b*c))%a, Math.floor(id/c)%b, id%c];
}
function bossesBefore(n){
  n=n|0; const cyc=Math.floor((n-1)/4), r=(n-1)%4;
  return cyc*10 + (r===0?0:r===1?1:r===2?3:6);
}
function bossSpriteKeys(){
  const keys=["boss","bossA","bossB","bossC","bossD","bossE","bossF"];
  for(let i=0;i<=26;i++) keys.push("ship"+i);
  return keys;
}
function makeBoss(n, idx){
  idx=idx|0;
  const id=bossesBefore(n)+idx;
  const [a,b,c]=uniqueTriple(id,N1.length,N2.length,N3.length);
  const keys=bossSpriteKeys();
  const sprite=keys[id%keys.length];
  const flip=Math.floor(id/keys.length)%2===1;
  const hue=(id*37+11)%360;
  const move=id%MOVE_NAME.length;
  const atk = (n===1&&idx===0)?0:(n===2&&idx===0)?1:(n===3&&idx===0)?2:(id%ATK_NAME.length);
  const body=id%12;
  return {
    id, n, idx, sprite, flip, name:N1[a]+" "+N2[b]+" "+N3[c],
    hue, move, atk, body,
    moveName:MOVE_NAME[move], atkName:ATK_NAME[atk],
    w:130+(id%7)*8, h:150+(id%5)*8
  };
}
function getLevel(n){
  n=clamp(n|0,1,MAX_LEVEL);
  const bosses=1+((n-1)%4);
  return {
    n, boss:makeBoss(n,0),
    bosses,
    killsNeed: n<=2 ? 6 : clamp(8 + Math.floor(n/4), 8, 22),
    spawnInterval: Math.max(16, (n<=3?96:72) - n*0.12),
    enemySpeed: (n<=2?0.75:1.05) + n*0.010,
    eliteChance: n<=2 ? 0.02 : clamp(0.08 + n*0.0015, 0.08, 0.55),
    enemyHp: 1 + Math.floor((n-1)/16),
    eliteHp: 2 + Math.floor((n-1)/11),
    playerDmg: 1 + Math.floor((n-1)/28),
    bossHp: n<=3 ? Math.floor(160 + n*28) : Math.floor(280 + n*22 + (n*n)/90),
    bossSpeed: 1.05 + n*0.017,
    bossChase: 0.55 + n*0.012,
    bossFire: n<=3 ? 90 : Math.max(16, 58 - n*0.1),
    allies: (n%10===0)?2:(n%5===0?1:0),
    dropChance: n<=3 ? 0.42 : clamp(0.24 + n*0.0004, 0.24, 0.42)
  };
}

