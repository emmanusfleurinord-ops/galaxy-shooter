      ctx.fillStyle="rgba(255,180,60,0.9)";
      ctx.beginPath(); ctx.arc(p.x,p.y,p.r||5,0,Math.PI*2); ctx.fill();
      ctx.fillStyle="rgba(255,80,20,0.5)";
      ctx.beginPath(); ctx.arc(p.x,p.y+3,(p.r||5)*0.7,0,Math.PI*2); ctx.fill();
    } else if(p.kind==="smoke"){
      ctx.globalAlpha=a*0.28;
      const g=ctx.createRadialGradient(p.x,p.y,0,p.x,p.y,p.r||8);
      g.addColorStop(0,"rgba(70,64,58,0.9)"); g.addColorStop(1,"rgba(20,18,16,0)");
      ctx.fillStyle=g; ctx.beginPath(); ctx.arc(p.x,p.y,p.r||8,0,Math.PI*2); ctx.fill();
    } else if(p.kind==="debris"){
      ctx.globalAlpha=a*0.9; ctx.translate(p.x,p.y); ctx.rotate(p.rot||0);
      ctx.fillStyle=p.color; ctx.fillRect(-(p.r||2),-1,(p.r||2)*2,2);
    } else {
      ctx.globalCompositeOperation="lighter";
      ctx.globalAlpha=a;
      ctx.fillStyle=p.color;
      ctx.beginPath(); ctx.arc(p.x,p.y,p.r||2,0,Math.PI*2); ctx.fill();
    }
    ctx.restore();
  });
  allies.forEach(a=>{ drawEngine(a.x-8,a.y+a.h/2-4); drawEngine(a.x+8,a.y+a.h/2-4); ctx.save(); ctx.globalAlpha=.92; ctx.shadowColor="#d6f"; ctx.shadowBlur=16; drawImg(playerImg(),a.x-a.w/2,a.y-a.h/2,a.w,a.h); ctx.restore(); });
  if(state!=="start"){
    const blink=invuln>0 && Math.floor(invuln/4)%2===0;
    const px=player.x-player.w/2, py=player.y-player.h/2;
    if(!(blink && state!=="gameover")){
      drawEngine(player.x-12,py+player.h-10); drawEngine(player.x+12,py+player.h-10);
      ctx.save();
      if(invuln>0){ ctx.filter="brightness(1.8) saturate(0.4)"; ctx.shadowColor="#f66"; ctx.shadowBlur=28; }
      else { ctx.shadowColor="#4df"; ctx.shadowBlur=22; }
      drawImg(playerImg(),px,py,player.w,player.h);
      ctx.restore();
      if(shieldHits>0){
        const pulse=.55+.35*Math.sin(tick/6);
        ctx.save();
        ctx.strokeStyle="rgba(80,230,255,"+pulse+")";
        ctx.fillStyle="rgba(40,200,255,"+(0.10+0.08*pulse)+")";
        ctx.lineWidth=4;
        ctx.beginPath(); ctx.ellipse(player.x,player.y+4,player.w*.62,player.h*.55,0,0,Math.PI*2);
        ctx.fill(); ctx.stroke();
        ctx.strokeStyle="rgba(180,255,255,"+(0.35+0.25*pulse)+")";
        ctx.lineWidth=2;
        ctx.beginPath(); ctx.ellipse(player.x,player.y+4,player.w*.50,player.h*.44,0,0,Math.PI*2); ctx.stroke();
        ctx.restore();
      }
    }
    if(invuln>0 && state!=="gameover"){
      ctx.fillStyle="rgba(255,40,40,"+(0.08+0.10*(invuln%6<3?1:0))+")";
      ctx.fillRect(0,0,W,H);
    }
  }
  ctx.setTransform(1,0,0,1,0,0);
  drawMiniMap();
  drawCountdown();
  if(state==="gameover"){
    ctx.fillStyle="rgba(0,0,10,.72)"; ctx.fillRect(0,0,W,H);
    ctx.textAlign="center"; ctx.fillStyle="#0ff"; ctx.font="bold 34px Segoe UI"; ctx.fillText("FIM DE JOGO",W/2,H/2-16);
    ctx.fillStyle="#fff"; ctx.font="18px Segoe UI"; ctx.fillText("Pontos: "+score+"   Nível: "+L.n,W/2,H/2+20);
    ctx.fillStyle="#8cf"; ctx.font="15px Segoe UI"; ctx.fillText("Aperte R ou escolha outro nível",W/2,H/2+50);
  }
}
function loop(){ update(); draw(); drawShipSpin(); requestAnimationFrame(loop); }

