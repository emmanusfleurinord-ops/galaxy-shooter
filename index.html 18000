function playerShoot(){
  const y=player.y-player.h/2+6;
  const sh=shipNow();
  const extra=sh.extra|0;
  if(laserTime>0){ fireLaserBeam(); player.cd=Math.max(4,Math.round(7*sh.cd)); sfx.shoot(); return; }
  if(missileTime>0){
    fireBolt(player.x-8,y,false,{kind:"missile",homing:true,w:8,h:14,vy:-6.2,dmg:L.playerDmg*(sh.dmg||1)*1.35});
    fireBolt(player.x+8,y,false,{kind:"missile",homing:true,w:8,h:14,vy:-6.2,dmg:L.playerDmg*(sh.dmg||1)*1.35});
    if(extra>=1) fireBolt(player.x,y-8,false,{kind:"missile",homing:true,w:8,h:14,vy:-6.5,dmg:L.playerDmg*(sh.dmg||1)*1.2});
    player.cd=Math.max(8,Math.round(16*sh.cd)); sfx.shoot(); return;
  }
  if(spreadTime>0){
    [-0.45,-0.22,0,0.22,0.45].forEach(a=>{
      fireBolt(player.x,y,false,{vx:Math.sin(a)*7.5, vy:-11*Math.cos(a), kind:"spread", w:5,h:16});
    });
    player.cd=Math.max(6,Math.round(12*sh.cd)); sfx.shoot(); return;
  }
  if(tripleTime>0){
    fireBolt(player.x-20,y); fireBolt(player.x,y-6); fireBolt(player.x+20,y);
    if(extra>=1) fireBolt(player.x,y-16);
    if(extra>=3) fireBolt(player.x-28,y+4);
    player.cd=Math.max(5,Math.round(9*sh.cd));
  } else if(doubleTime>0){
    fireBolt(player.x-16,y); fireBolt(player.x+16,y);
    if(extra>=1) fireBolt(player.x,y-8);
    if(extra>=3) fireBolt(player.x,y-16);
    player.cd=Math.max(5,Math.round(10*sh.cd));
  } else {
    fireBolt(player.x,y);
    if(extra>=1) fireBolt(player.x-12,y+4);
    if(extra>=2) fireBolt(player.x+12,y+4);
    if(extra>=3) fireBolt(player.x,y-10);
    player.cd=Math.max(5,Math.round(13*sh.cd));
  }
  sfx.shoot();
}
